# No environment variables are required for the default local archive.
#
# Optional: set this if you want generated metadata to point at a custom local URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the local SQLite file used by server API routes.
# STEADYTRACK_LOCAL_DB=.local/steadytrack.sqlite

# Optional: used only by scripts/generate_microcards.ts when generating new local
# study cards from an LLM. The app itself does not need this.
# OPENAI_API_KEY=
