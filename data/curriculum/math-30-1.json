      "id": "m30_transformations",
      "title": "Transformations",
      "topics": [
        "Horizontal and vertical translations",
        "Reflections across axes",
        "Vertical and horizontal stretches",
        "Combinations of transformations",
        "Mapping notation"
      ],
      "estimatedHours": 5,
      "outcomes": [
        {
          "code": "RF1",
          "description": "- Explain how horizontal and vertical translations affect function graphs and their equations.",
          "strand": "Relations and Functions"
        },
        {
          "code": "RF2",
          "description": "- Explain the effects of horizontal and vertical stretches on function graphs and their equations.",
          "strand": "Relations and Functions"
        },
        {
          "code": "RF10",
          "description": "- Factor polynomials of degree 3-5 with integral coefficients.",
          "type": "general"
        },
        {
          "code": "RF11",
          "description": "- Graph and analyze polynomial functions (limited to polynomial functions of degree ≤ 5).",
          "type": "general"
        },
        {
          "code": "RF12",
          "description": "- Graph and analyze radical functions (limited to functions involving one radical).",
          "type": "general"
        },
        {
          "code": "RF13",
          "description": "- Graph and analyze rational functions with monomial, binomial, or trinomial numerators and denominators.",
          "type": "general"
        },
        {
          "code": "RF5",
          "description": "- Explain inverses of relations.",
          "type": "general"
        }
