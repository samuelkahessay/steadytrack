    {
      "id": "rational-expressions",
      "title": "Rational Expressions & Equations",
      "estimatedHours": 5,
      "outcomes": [
        {
          "code": "A4",
          "description": "- Determine equivalent forms of rational expressions with monomial, binomial, or trinomial numerators and denominators.",
          "strand": "Algebra and Number"
        },
        {
          "code": "A5",
          "description": "- Perform operations on rational expressions with monomial, binomial, or trinomial numerators and denominators.",
          "strand": "Algebra and Number"
        },
        {
          "code": "A6",
          "description": "- Solve rational equations with monomial, binomial, or trinomial numerators and denominators that simplify to linear or quadratic equations.\n- Determine non-permissible values for the variable in a rational equation.\n- Solve rational equations algebraically and explain the process used.\n- Explain why a value obtained may not be a solution (extraneous solution).\n- Model and solve problems using rational equations.",
          "strand": "Algebra and Number"
        }
      ],
      "topics": [
        "Non-permissible values and restrictions",
        "Simplifying rational expressions",
        "Multiplying and dividing rational expressions",
        "Adding and subtracting rational expressions",
        "Solving rational equations",
        "Applications of rational expressions"
      ],
