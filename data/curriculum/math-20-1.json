          "strand": "Algebra and Number"
        },
        {
          "code": "A2",
          "description": "- Solve problems involving operations on radicals and radical expressions with numerical and variable radicands.",
          "strand": "Algebra and Number"
        },
        {
          "code": "A3",
          "description": "- Determine restrictions on variable values for radical equations involving square roots.\n- Solve radical equations algebraically, including cases requiring one or two squarings.\n- Verify solutions by substitution and explain any extraneous roots.\n- Model and solve problems using square-root radical equations.",
          "strand": "Algebra and Number"
        }
      ],
